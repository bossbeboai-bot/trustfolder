# --- AI ---
# Provider switch. One of: anthropic (default) | ollama
AI_PROVIDER=anthropic

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_PRIMARY=claude-3-5-sonnet-20241022
ANTHROPIC_MODEL_FALLBACK=claude-3-5-haiku-20241022

# Ollama / Ollama-compatible (used when AI_PROVIDER=ollama)
# Local Ollama usually needs no API key — leave OLLAMA_API_KEY empty.
# If using a hosted Ollama-compatible endpoint, set OLLAMA_API_KEY and it will
# be sent server-side as `Authorization: Bearer <key>`. Never exposed to the client.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=deliveries

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# --- Email (Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@trustfolder.com
RESEND_REPLY_TO=hello@trustfolder.com

# --- App ---
APP_BASE_URL=http://localhost:3000
APP_NAME=TrustFolder

# --- Templates ---
TEMPLATES_DIR=../templates

# --- Crawler ---
CRAWLER_TIMEOUT_MS=12000
CRAWLER_USER_AGENT=TrustFolderBot/0.1 (+https://trustfolder.com/bot)

# --- Generation ---
GENERATION_MAX_RETRIES=1
QA_MIN_SCORE=80
SIGNED_URL_TTL_SECONDS=604800

# --- Founder alert channel (optional) ---
# Slack incoming-webhook URL (or any JSON receiver). Used to surface:
#   - new request submissions (info)
#   - failed_needs_retry (error)
#   - PayPal capture denied / refunded / reversed (warn / info)
# If empty, alerts silently no-op. Customer flow never fails because of this.
ALERT_WEBHOOK_URL=

# --- Phase 7 production hardening ---
# Founder + customer support inboxes. Used as fallback if ALERT_WEBHOOK_URL is
# empty and as the customer-facing support address in transactional emails.
ADMIN_EMAIL=
SUPPORT_EMAIL=

# Production runtime flag.
NODE_ENV=production
