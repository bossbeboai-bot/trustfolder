# Inherit all engine env vars (the app re-uses the engine .env at runtime)
# See ../engine/.env.example for the full list.

# At minimum:
# AI provider switch. One of: anthropic (default) | ollama
AI_PROVIDER=anthropic

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=placeholder_anthropic_api_key

# Ollama / Ollama-compatible (used when AI_PROVIDER=ollama)
# Server-only. Never exposed to the client. If OLLAMA_API_KEY is empty,
# no Authorization header is sent (typical for local Ollama).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:7b-instruct

SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_ANON_KEY=placeholder_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=placeholder_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=deliveries
PAYPAL_CLIENT_ID=placeholder_paypal_client_id
PAYPAL_CLIENT_SECRET=placeholder_paypal_client_secret
PAYPAL_WEBHOOK_ID=placeholder_paypal_webhook_id
PAYPAL_ENV=sandbox
RESEND_API_KEY=placeholder_resend_api_key
RESEND_FROM_EMAIL=placeholder@example.com
APP_BASE_URL=http://localhost:3000
TEMPLATES_DIR=../templates

# Public PayPal client ID for the SPA (same value, exposed to the client)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=placeholder_public_paypal_client_id

# Public Supabase keys (used only for diagnostics; never service-role on the client)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder_public_supabase_anon_key

# Admin dashboard (Phase 3.6 v1).
# - ADMIN_PASSWORD is the single-seat password gating /admin/* and /api/admin/*.
#   Server-only. Never log it. Never expose it to the client.
# - ADMIN_SESSION_SECRET (optional) is used to HMAC-sign the admin session
#   cookie. If left empty, ADMIN_PASSWORD is used as the signing key. Set this
#   if you ever want to rotate the session secret without rotating the password.
ADMIN_PASSWORD=placeholder_admin_password
ADMIN_SESSION_SECRET=placeholder_admin_session_secret

# Customer dashboard sessions (Phase 5+).
CUSTOMER_SESSION_SECRET=placeholder_customer_session_secret

# Founder alert routing (Phase 7).
# If ALERT_WEBHOOK_URL is empty, alerts fall back to ADMIN_EMAIL.
ADMIN_EMAIL=admin@example.com
SUPPORT_EMAIL=support@example.com
ALERT_WEBHOOK_URL=

# Production runtime.
NODE_ENV=production
